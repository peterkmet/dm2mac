#!/bin/bash
# Renames a public symbol (whole word) in the sources, tests and docs.
# Usage: tools/rename-symbol OLD NEW
#        tools/rename-symbol --files FILE... OLD NEW   (named files only, no check of NEW)
root=$(git rev-parse --show-toplevel) || exit 1
files=()
if [ "$1" = "--files" ]; then
    shift
    while [ $# -gt 2 ]; do
        if [ ! -f "$1" ]; then
            echo "error: no such file: $1" >&2
            exit 1
        fi
        files+=("$(cd "$(dirname "$1")" && pwd)/$(basename "$1")")
        shift
    done
fi
if [ $# -ne 2 ]; then
    echo "usage: tools/rename-symbol [--files FILE...] OLD NEW" >&2
    exit 2
fi
old=$1
new=$2
cd "$root" || exit 1
if [ ${#files[@]} -eq 0 ]; then
    if git ls-files 'src/*.c' 'src/*.h' | grep -v '^src/third_party/' |
        xargs grep -lw -- "$new" 2>/dev/null | grep -q .; then
        echo "error: $new already occurs as a word in src/" >&2
        exit 1
    fi
    while IFS= read -r f; do files+=("$f"); done < <(
        git ls-files 'src/*.c' 'src/*.h' 'tests/*.py' 'docs/*.md' 'docs/skull-symbols.csv' CLAUDE.md |
            grep -v -e '^src/third_party/' -e '^docs/.*/')
fi
for f in "${files[@]}"; do
    if grep -qw -- "$old" "$f"; then
        OLD=$old NEW=$new perl -pi -e 's/\b\Q$ENV{OLD}\E\b/$ENV{NEW}/g' "$f"
        echo "$f"
    fi
done
