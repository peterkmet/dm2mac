BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 120
BreakBeforeBraces: Linux
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AlignTrailingComments: true
AlignConsecutiveMacros: AcrossComments
AlignArrayOfStructures: Left
IndentCaseLabels: false
PointerAlignment: Right
SortIncludes: CaseSensitive
IncludeBlocks: Merge
IncludeCategories:
  - Regex: '^"(gdat|gfx|hmp|ids|le|mve|os|pcx|settings|mve_internal)\.h"$'
    Priority: 1
  - Regex: '^"(action|ai|ai_move|aspect|champ_action|champion|creature|dungeon|game|game_text|hooks|inventory|item|magic|merchant|minion|money|move|projectile|random|recruit|save|seen|sensor|sound_request|timeline|weather|ai_move_internal|ai_internal)\.h"$'
    Priority: 2
  - Regex: '^"(action_area|advanced|automap|cheats|dialog|draw|fm|icon|input|minion_map|mode_screen|movie|music|optmenu|play|rows|session|sound|text|ui|video|view|zone|ui_internal)\.h"$'
    Priority: 3
  - Regex: '^"(control|state_json|turn)\.h"$'
    Priority: 4
  - Regex: '^"(platform|scale|transport)\.h"$'
    Priority: 5
  - Regex: '^<(opl3|SDL3)/'
    Priority: 6
  - Regex: '^<'
    Priority: 7
ReflowComments: false
